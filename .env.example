# Spotify Configuration
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID='your_spotify_client_id'
SPOTIFY_SECRET_ID='your_spotify_client_secret'

# Optional Last.fm API Key (if set, users only need to enter their Last.fm username)
# Get one at https://www.last.fm/api/account/create
# LASTFM_API_KEY='your_lastfm_api_key'

# Base URL for the callback (must match your Spotify / Deezer App settings)
# For local dev: http://localhost:3000/callback
REDIRECT_URI='http://localhost:3000/callback'

# Server Configuration
PORT=3000
SESSION_SECRET="your_secure_random_string"

# Firebase Configuration
# Get these from your Firebase Console (Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID='your_firebase_project_id'

# You can provide the service account as a JSON string (encoded or raw)
# or provide a path to the JSON file.
FIREBASE_SERVICE_ACCOUNT='your_raw_or_base64_service_account_json'
# FIREBASE_SERVICE_ACCOUNT_PATH='./service-account.json'
